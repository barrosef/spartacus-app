{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "jsx": "react-native",
    "noEmit": true
  },
  "include": [
    "src"
  ],
  "extends": "expo/tsconfig.base"
}
