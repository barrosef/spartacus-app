{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // target/module/moduleResolution/lib vêm do expo/tsconfig.base (SDK 54:
    // module "preserve" + moduleResolution "bundler" + customConditions).
    // Sobrescrever com CommonJS/node quebra o customConditions (TS5098).
    "jsx": "react-native",
    "noEmit": true
  },
  "include": [
    "src"
  ],
  "extends": "expo/tsconfig.base"
}
